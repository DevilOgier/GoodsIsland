# Design-stage configuration contract; application implementation is pending.
DATABASE_URL=postgresql://guzi:replace_me@localhost:5432/guzi
APP_URL=http://localhost:3000
AUTH_SECRET=
ADMIN_EMAIL=
# Create initial credentials interactively; never commit passwords.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=guzi
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# mock | topaz | realesrgan (realesrgan is an optional later adapter)
IMAGE_ENHANCEMENT_PROVIDER=mock
IMAGE_ENHANCEMENT_API_KEY=
IMAGE_ENHANCEMENT_MODEL=
IMAGE_ENHANCEMENT_MAX_OUTPUT_PIXELS=24000000
IMAGE_ENHANCEMENT_CONCURRENCY=1
# Optional executable adapter, not a third-party endpoint contract.
REALESRGAN_EXECUTABLE=
REALESRGAN_MODEL_PATH=
