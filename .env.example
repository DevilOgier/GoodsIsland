# Copy to .env, or run node scripts/setup.mjs to create random local DB credentials.
DATABASE_URL=postgresql://guzi:replace_me@127.0.0.1:54329/guzi
APP_URL=http://localhost:3000
AUTH_SECRET=
COOKIE_SECURE=false
WEB_HOST=127.0.0.1
PORT=3000
LOCAL_SERVICES=true
NEXT_TELEMETRY_DISABLED=1
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=guzi
# These are emulator-only credentials; use real server-only keys for production S3.
S3_ACCESS_KEY=S3RVER
S3_SECRET_KEY=S3RVER
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
IMAGE_ENHANCEMENT_PROVIDER=mock
IMAGE_ENHANCEMENT_API_KEY=
IMAGE_ENHANCEMENT_MODEL=High Fidelity V2
# Required only for Docker Compose; match the password in DATABASE_URL.
POSTGRES_PASSWORD=
