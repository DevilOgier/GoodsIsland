{
  "name": "guzi-cabinet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "node --env-file=.env scripts/web.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --env-file=.env --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "local:setup": "node scripts/setup.mjs",
    "local:services": "node --env-file=.env scripts/services.mjs",
    "worker": "tsx --env-file=.env src/workers/image-worker.ts",
    "local": "node scripts/local.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@prisma/client": "6.19.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "pg": "^8.16.3",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "s3rver": "3.7.1",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
