# Save as /opt/goods-island/.env on the SERVER, chmod 600. Never commit real values.
POSTGRES_PASSWORD=replace_with_long_random_password
DATABASE_URL=postgresql://guzi:replace_with_long_random_password@db:5432/guzi
APP_URL=https://your-domain.example
SITE_ADDRESS=your-domain.example
# Before having a domain, use APP_URL=http://SERVER_IP and SITE_ADDRESS=http://SERVER_IP
COOKIE_SECURE=true
ADDITIONAL_APP_ORIGINS=
AUTH_SECRET=replace_with_long_random_secret
LOCAL_SERVICES=false
WEB_HOST=0.0.0.0
PORT=3000
S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_BUCKET=your-private-bucket
S3_REGION=your-region
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_FORCE_PATH_STYLE=true
IMAGE_ENHANCEMENT_PROVIDER=mock
IMAGE_ENHANCEMENT_API_KEY=
IMAGE_ENHANCEMENT_MODEL=High Fidelity V2
APP_IMAGE=ghcr.io/devilogier/goodsisland:initial
